DB_PORT=5432
DB_NAME=enterprise_risk_db
DB_USER=postgres
DB_PASSWORD=postgres
SERVER_PORT=8080
# Required for direct backend startup. Use a unique Base64 key with at least 32 random bytes.
# The Windows development launcher generates a process-local key when this is blank.
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
AI_SERVICE_ENABLED=true
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_CONNECT_TIMEOUT_MS=2000
AI_SERVICE_READ_TIMEOUT_MS=5000
AI_INVENTORY_RISK_CRON=0 */15 * * * *
GDELT_LAST_UPDATE_URL=https://data.gdeltproject.org/gdeltv2/lastupdate.txt
